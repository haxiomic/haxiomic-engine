{
    "compilerOptions": {
        "strict": true,
        "noEmit": false,
        "module": "NodeNext",
        "moduleResolution": "nodenext",
        "allowArbitraryExtensions": true,
        "declaration": true,
        "jsx": "react",
        "outDir": "./dist",
        "allowJs": true,
        "skipLibCheck": true
    },
    "exclude": [
        "dist",
        "node_modules",
        "tests",
        "playwright.config.js"
    ]
}
